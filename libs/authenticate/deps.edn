{:paths ["src"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.5"}
         com.biffweb/fx            {:local/root "../fx"}
         com.biffweb/stuff         {:local/root "../stuff"}
         tick/tick                 {:mvn/version "1.0.1"}
         hato/hato                 {:mvn/version "1.0.0"}
         ring/ring-anti-forgery    {:mvn/version "1.4.0"}
         dev.onionpancakes/chassis {:mvn/version "1.0.365"}}

 :aliases
 {:run  {:extra-paths ["test" "dev"]
         :extra-deps  {com.biffweb/tasks {:local/root "../tasks"}}
         :main-opts   ["-m" "com.biffweb.tasks.lib"]}
  :demo {:extra-paths ["demo"]
         :extra-deps  {org.slf4j/slf4j-simple  {:mvn/version "2.0.18"}
                       nrepl/nrepl             {:mvn/version "1.7.0"}
                       cider/cider-nrepl       {:mvn/version "0.62.2"}
                       ring/ring-jetty-adapter {:mvn/version "1.15.4"}
                       ring/ring-defaults      {:mvn/version "0.7.0"}
                       metosin/reitit-ring     {:mvn/version "0.10.1"}}
         :main-opts   ["-m" "demo"]}}}
